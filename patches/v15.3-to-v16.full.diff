+ppd_state_value() {
+  local f="$1" key="$2" line v=false
+  while IFS= read -r line || [[ -n "$line" ]]; do
+    line="${line%%#*}"
+    line="${line//[[:space:]]/}"
+    line="${line//\"/}"
+    [[ "$line" == "$key="* ]] && v="${line#*=}"
+  done < "$f"
